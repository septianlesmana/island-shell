<Window x:Class="DynamicIsland.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu Bar" Height="32" Width="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="10" Padding="7,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Glass capsule: translucent dark (wallpaper shows through), thin light edge, white text -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#66202024" Offset="0"/>
                        <GradientStop Color="#59000000" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Transparent menu bar; content sits in translucent dark glass capsules with a light edge
         (like the latest macOS menu bar). Capsule darkness: alpha "59" in the Pill style. -->
    <Border Background="Transparent">
    <Grid Margin="6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Now playing: artwork, title - artist, equalizer (click = play/pause) -->
        <Border x:Name="MediaPill" Style="{StaticResource Pill}" Margin="0,0,8,0" Cursor="Hand"
                Visibility="Collapsed" ToolTip="Play / pause" MouseLeftButtonUp="Media_Click">
            <StackPanel Orientation="Horizontal" Margin="1,0,6,0">
                <Border Width="18" Height="18" CornerRadius="5" Background="#33FFFFFF" VerticalAlignment="Center">
                    <Image x:Name="MediaArt" Width="18" Height="18" Stretch="UniformToFill">
                        <Image.Clip><RectangleGeometry Rect="0,0,18,18" RadiusX="5" RadiusY="5"/></Image.Clip>
                    </Image>
                </Border>
                <TextBlock x:Name="MediaText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="7,0,8,0" MaxWidth="170"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel x:Name="MediaEq" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle x:Name="MEq1" Width="2.5" Height="11" Margin="0.8,0" Fill="White" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="MEq2" Width="2.5" Height="11" Margin="0.8,0" Fill="White" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="MEq3" Width="2.5" Height="11" Margin="0.8,0" Fill="White" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="MEq4" Width="2.5" Height="11" Margin="0.8,0" Fill="White" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.75"/></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Left capsule (system menu + active app) and right capsule (search + date & time),
                separate; the middle is left empty for the notch. -->
        <Grid Grid.Column="1">
            <Border Style="{StaticResource Pill}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="StartBtn" Style="{StaticResource BarBtn}" ToolTip="System Menu" Click="Start_Click">
                        <UniformGrid Rows="2" Columns="2" Width="12" Height="12">
                            <Rectangle Fill="White" Margin="0,0,1,1"/>
                            <Rectangle Fill="White" Margin="1,0,0,1"/>
                            <Rectangle Fill="White" Margin="0,1,1,0"/>
                            <Rectangle Fill="White" Margin="1,1,0,0"/>
                        </UniformGrid>
                    </Button>
                    <TextBlock x:Name="AppName" Foreground="White" FontSize="12.5" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="2,0,4,0" MaxWidth="220"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- Active app menus: File, Edit, View, ... (filled from code) -->
                    <StackPanel x:Name="AppMenusPanel" Orientation="Horizontal" Margin="0,0,4,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Order: Search, Wi-Fi, Control Center, Show Desktop, Battery, Clock -->
                    <Button x:Name="SearchBtn" Style="{StaticResource BarBtn}" ToolTip="Search" Click="Search_Click">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}"/>
                    </Button>
                    <!-- Search box: appears below the 🔍 icon and extends to the right (doesn't cover the notch) -->
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBtn}" Placement="Bottom"
                           VerticalOffset="6" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                        <StackPanel Margin="0,0,10,12">
                        <Border x:Name="SearchField" Width="0" Height="30" CornerRadius="15" Background="#E61E1E20"
                                BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#B3FFFFFF"
                                           FontSize="12" Margin="11,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SearchHint" Text="Search apps, files, web…" Foreground="#99FFFFFF"
                                           FontSize="12.5" VerticalAlignment="Center" Margin="32,0,0,1" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White"
                                         CaretBrush="White" FontSize="12.5" VerticalContentAlignment="Center"
                                         Padding="0,0,10,0" Margin="28,0,0,1"
                                         KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <!-- Spotlight-style results: apps, Settings, web -->
                        <Border x:Name="SearchResultsBox" Width="340" Margin="0,6,0,0" CornerRadius="12" Background="#F01E1E20"
                                BorderBrush="#40FFFFFF" BorderThickness="1" Padding="5" HorizontalAlignment="Left"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel x:Name="SearchResults"/>
                        </Border>
                        </StackPanel>
                    </Popup>
                    <!-- Wi-Fi & Control Center → click opens Control Center -->
                    <Button x:Name="WifiBtn" Style="{StaticResource BarBtn}" ToolTip="Wi-Fi" Click="QuickSettings_Click">
                        <TextBlock x:Name="WifiIcon" Text="&#xE701;" Style="{StaticResource Glyph}"/>
                    </Button>
                    <Button x:Name="StatusBtn" Style="{StaticResource BarBtn}" ToolTip="Control Center" Click="QuickSettings_Click">
                        <TextBlock Text="&#xE9E9;" Style="{StaticResource Glyph}"/>
                    </Button>
                    <!-- Show desktop; click again = all windows come back -->
                    <Button x:Name="DesktopBtn" Style="{StaticResource BarBtn}" ToolTip="Show Desktop" Click="Desktop_Click">
                        <TextBlock x:Name="DesktopIcon" Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
                    </Button>
                    <!-- Microphone (orange) / camera (green) in use, like macOS -->
                    <StackPanel x:Name="PrivacyBox" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="4,0,4,0" Visibility="Collapsed" Background="Transparent">
                        <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="2,0" Visibility="Collapsed"/>
                        <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#30D158" Margin="2,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <!-- Battery: percentage INSIDE the battery icon (like iPhone/macOS) -->
                    <Button x:Name="BatteryBtn" Style="{StaticResource BarBtn}" ToolTip="Battery" Click="QuickSettings_Click">
                        <StackPanel x:Name="BatteryBox" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="29" Height="14" BorderBrush="#D9FFFFFF" BorderThickness="1.2"
                                    CornerRadius="4" Padding="1.5" VerticalAlignment="Center">
                                <Grid>
                                    <Border x:Name="BatteryFill" Background="White" CornerRadius="2"
                                            HorizontalAlignment="Left" Width="10"/>
                                    <TextBlock x:Name="BatteryPct" FontSize="8.5" FontWeight="Bold" Foreground="#1D1D1F"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0.5"/>
                                </Grid>
                            </Border>
                            <Border Width="1.8" Height="5" Background="#D9FFFFFF" CornerRadius="0,1,1,0"
                                    Margin="1,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Background apps (Windows system tray) -->
                    <Button x:Name="TrayBtn" Style="{StaticResource BarBtn}" ToolTip="Background apps" Click="Tray_Click" Visibility="Collapsed">
                        <TextBlock Text="&#xE70E;" Style="{StaticResource Glyph}" FontSize="11"/>
                    </Button>
                    <!-- Focus / Do Not Disturb -->
                    <Button x:Name="FocusBtn" Style="{StaticResource BarBtn}" ToolTip="Focus (Do Not Disturb)" Click="Focus_Click" Visibility="Collapsed">
                        <TextBlock x:Name="FocusIcon" Text="&#xE708;" Style="{StaticResource Glyph}" Opacity="0.55"/>
                    </Button>
                    <Button x:Name="ClockBtn" Style="{StaticResource BarBtn}" ToolTip="Notification Center" Click="Clock_Click">
                        <TextBlock x:Name="ClockText" FontSize="12.5" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Latest notification: app icon + "Title: body" (click = Notification Center) -->
        <Border x:Name="NotifPill" Grid.Column="2" Style="{StaticResource Pill}" Margin="8,0,0,0" Cursor="Hand"
                Visibility="Collapsed" MouseLeftButtonUp="Notif_Click">
            <StackPanel Orientation="Horizontal" Margin="2,0,8,0">
                <Image x:Name="NotifIcon" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="NotifText" Foreground="White" FontSize="12" VerticalAlignment="Center"
                           Margin="7,0,0,0" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 4. Bubble with the notifying app + count badge (click = open the app) -->
        <Grid x:Name="AppBubble" Grid.Column="3" Margin="6,0,0,0" Width="26" Height="26" Cursor="Hand"
              Visibility="Collapsed" MouseLeftButtonUp="Bubble_Click" VerticalAlignment="Center">
            <Border CornerRadius="13" Background="#59000000" BorderBrush="#40FFFFFF" BorderThickness="1">
                <Image x:Name="BubbleIcon" Width="16" Height="16"/>
            </Border>
            <Border x:Name="BubbleBadge" MinWidth="13" Height="13" CornerRadius="6.5" Background="#FF3B30"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" Padding="3,0">
                <TextBlock x:Name="BubbleBadgeText" Foreground="White" FontSize="8.5" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
