<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="1100" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Muted" Color="#8E8E93"/>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="11" Padding="10,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Notch: attached to the top edge. Its shape is drawn by IslandShape (top corners curve
             outward to blend into the screen edge, bottom corners rounded) -->
        <Border x:Name="Island" Width="190" Height="32" Background="Transparent"
                HorizontalAlignment="Center" VerticalAlignment="Top" AllowDrop="False"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                DragEnter="Island_DragEnter" DragOver="Island_DragOver"
                DragLeave="Island_DragLeave" Drop="Island_Drop">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="AutoStartItem" Header="Open at Login"
                              IsCheckable="True" Click="AutoStart_Click"/>
                    <Separator/>
                    <MenuItem Header="Restart Dynamic Island" Click="Restart_Click"/>
                    <MenuItem Header="Quit Dynamic Island" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Notch shape; extends 12 px left & right for the concave top "ears" -->
                <Path x:Name="IslandShape" Fill="Black" Margin="-12,0,-12,0" IsHitTestVisible="False"/>

                <!-- ===== Compact: small artwork on the left, equalizer on the right ===== -->
                <Grid x:Name="CompactPanel" Margin="10,0">
                    <!-- Compact notch: badge with the number of In Progress notes (Notes tab) -->
                    <Border x:Name="NotesCompactBadge" Height="18" CornerRadius="9" Background="#0A84FF" Padding="7,0,8,0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="Notes in progress">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="8" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="NotesCompactBadgeText" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="MiniArtBox" Width="20" Height="20" CornerRadius="5" Background="#2C2C2E"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Image x:Name="MiniArt" Width="20" Height="20" Stretch="UniformToFill">
                            <Image.Clip><RectangleGeometry Rect="0,0,20,20" RadiusX="5" RadiusY="5"/></Image.Clip>
                        </Image>
                    </Border>
                    <!-- Title of the playing song -->
                    <TextBlock x:Name="MiniTitle" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="28,0,28,1" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="EqPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle x:Name="Eq1" Width="3" Height="13" Margin="1,0" Fill="#30D158"
                                   RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Eq2" Width="3" Height="13" Margin="1,0" Fill="#30D158"
                                   RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Eq3" Width="3" Height="13" Margin="1,0" Fill="#30D158"
                                   RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- ===== Short notification ===== -->
                <StackPanel x:Name="NotifPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="NotifIcon" FontFamily="{StaticResource Icons}" FontSize="15"
                               Foreground="#30D158" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="NotifText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" MaxWidth="270" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- ===== Expanded: tabs ===== -->
                <Grid x:Name="ExpandedPanel" Margin="16,8,14,14" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Header: tabs + buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="NotesTab" Style="{StaticResource TabBtn}" GroupName="IslandTabs"
                                     IsChecked="True" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70B;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Notes"/>
                                <!-- Badge: number of In Progress notes -->
                                <Border x:Name="NotesTabBadge" MinWidth="16" Height="16" CornerRadius="8" Background="#0A84FF"
                                        Margin="6,0,0,0" Padding="4,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="NotesTabBadgeText" Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="CalendarTab" Style="{StaticResource TabBtn}" GroupName="IslandTabs"
                                     Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Calendar"/>
                            </StackPanel>
                        </RadioButton>
                        <!-- Controls tab hidden: Control Center lives in the menu bar (battery/Wi-Fi icons) -->
                        <RadioButton x:Name="ControlsTab" Style="{StaticResource TabBtn}" GroupName="IslandTabs"
                                     Checked="Tab_Checked" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE701;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Controls"/>
                            </StackPanel>
                        </RadioButton>
                        <!-- Tray tab hidden (unused) -->
                        <RadioButton x:Name="TrayTab" Style="{StaticResource TabBtn}" GroupName="IslandTabs" Visibility="Collapsed"
                                     Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Tray"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- "+ New" button for the Notes tab -->
                        <Button x:Name="NotesNewBtn" Click="NotesNew_Click" Cursor="Hand" Focusable="False"
                                Visibility="Visible" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- Exactly 24 px tall, icon + text centered (aligned with the ⚙ icon) -->
                                    <Border x:Name="bg" Background="#0A84FF" CornerRadius="12" Height="24" Padding="10,0,12,0"
                                            VerticalAlignment="Center" SnapsToDevicePixels="True">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                       Foreground="White" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                            <TextBlock Text="New" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="0,0,0,1"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#3398FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel x:Name="CalendarButtons" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE72C;"
                                    ToolTip="Refresh" Click="CalendarReload_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE8A7;"
                                    ToolTip="Open in Browser" Click="CalendarBrowser_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE71B;"
                                    ToolTip="Connect Google Calendar" Click="CalendarSetup_Click"/>
                        </StackPanel>
                        <Button x:Name="ClearTrayBtn" Style="{StaticResource IconBtn}" Content="&#xE74D;"
                                ToolTip="Clear Tray" Visibility="Collapsed" Click="ClearTray_Click"/>
                        <Button x:Name="GearBtn" Style="{StaticResource IconBtn}" Content="&#xE713;"
                                ToolTip="Settings" Click="Gear_Click"/>
                    </StackPanel>

                    <!-- Calendar tab content: Google Calendar widget -->
                    <Border x:Name="CalendarContent" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                        <local:CalendarWidget x:Name="CalendarView"/>
                    </Border>

                    <!-- Notes tab content -->
                    <local:NotesView x:Name="NotesContent" Grid.Row="1" Margin="0,4,0,0"/>

                    <!-- Controls tab content: Control Center (rebuilt on open so data is fresh) -->
                    <Border x:Name="ControlsContent" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Top"/>

                    <!-- Tray tab content -->
                    <Grid x:Name="TrayContent" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="#40FFFFFF" StrokeThickness="1.5"
                                   StrokeDashArray="4 3"/>
                        <StackPanel x:Name="TrayHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="20"
                                       Foreground="#8E8E93" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop files here to keep them for later" Foreground="#8E8E93"
                                       FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,6">
                            <StackPanel x:Name="TrayPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
