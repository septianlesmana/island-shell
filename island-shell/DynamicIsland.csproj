<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 TFM to use the built-in Windows media & battery APIs -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wallpapers for "Apply macOS Look" (copied to the build output) -->
    <None Update="Assets\wallpaper-macos.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\wallpaper-macos-light.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads Google Calendar (iCal format) for the calendar widget -->
    <PackageReference Include="Ical.Net" Version="4.2.0" />
    <!-- Screen brightness in Control Center -->
    <PackageReference Include="System.Management" Version="8.0.*" />
    <!-- Reads Windows notification counts for Dock badges -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
  </ItemGroup>

</Project>
