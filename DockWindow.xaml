<Window x:Class="DynamicIsland.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock" Height="170" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowDrop="True" DragOver="Dock_DragOver" Drop="Dock_Drop"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Grid x:Name="DockRoot" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6">
        <!-- Slid down off-screen when the Dock auto-hides -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DockShift"/>
        </Grid.RenderTransform>

        <!-- Glass panel behind the icons -->
        <Border x:Name="Glass" Height="62" VerticalAlignment="Bottom" CornerRadius="18"
                Background="#5CF2F2F7" BorderBrush="#80FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add App…" Click="AddApp_Click"/>
                    <MenuItem x:Name="AutoHideItem" Header="Automatically Hide the Dock"
                              IsCheckable="True" Click="AutoHide_Click"/>
                    <MenuItem x:Name="MinimalIconsItem" Header="Minimal Icons"
                              IsCheckable="True" Click="MinimalIcons_Click"/>
                    <Separator/>
                    <MenuItem Header="Sync with Windows Taskbar" Click="SyncTaskbar_Click"/>
                    <MenuItem Header="Restore Default Apps" Click="Reset_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit Dynamic Island" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <!-- App icons; grow upward when magnified -->
        <StackPanel x:Name="IconsPanel" Orientation="Horizontal" VerticalAlignment="Bottom"
                    Margin="8,0,8,4" Background="Transparent"
                    MouseMove="Icons_MouseMove" MouseLeave="Icons_MouseLeave"/>

        <TextBlock x:Name="EmptyHint" Text="Drag apps here" Foreground="#E61C1C1E"
                   FontSize="14" Margin="28,0,28,22" VerticalAlignment="Bottom"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</Window>
